import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm, expon

# Normal Distribution
mean_value = 100
std_dev = 15
x_values = np.linspace(mean_value - 4 * std_dev,
                       mean_value + 4 * std_dev, 1000)
normal_density = norm.pdf(x_values, mean_value, std_dev)

# Exponential Distribution
rate_value = 0.2
time_values = np.linspace(0, 25, 1000)
exp_density = expon.pdf(time_values, scale=5.0)

# Central Limit Theorem
np.random.seed(43)
population_data = np.random.exponential(scale=5.0, size=10000)

mean_samples = [
    np.mean(np.random.choice(population_data, size=30))
    for _ in range(1000)
]

# Create horizontal subplots
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

# 1. Normal Distribution
axes[0].plot(x_values, normal_density,
             color="teal", linewidth=2)
axes[0].set_title("Normal Distribution")
axes[0].set_xlabel("Observation (X)")
axes[0].set_ylabel("Density")
axes[0].grid(True, linestyle="--", alpha=0.5)

# 2. Exponential Distribution
axes[1].plot(time_values, exp_density,
             color="purple", linewidth=2)
axes[1].set_title("Exponential Distribution")
axes[1].set_xlabel("Waiting Time")
axes[1].set_ylabel("Density")
axes[1].grid(True, linestyle=":", alpha=0.6)

# 3. Central Limit Theorem
axes[2].hist(mean_samples, bins=30, density=True,
             color="lightpink", edgecolor="white")
axes[2].set_title("Central Limit Theorem: Sample Mean Distribution")
axes[2].set_xlabel("Average of Sample")
axes[2].set_ylabel("Density")
axes[2].grid(True, linestyle="--", alpha=0.4)

# Equal spacing between all graphs
plt.subplots_adjust(wspace=0.35)

plt.show()

print("Average of population:",
      round(np.mean(population_data), 2))

print("Average across sample means:",
      round(np.mean(mean_samples), 2))
