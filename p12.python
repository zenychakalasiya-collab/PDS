import numpy as np
from scipy import stats

d1 = np.array([12,15,14,10,18,20,15,16,14,13])
d2 = np.array([10,12,11,14,13,15,12,16,11,14])

print("Dataset 1:", d1)
print("Dataset 2:", d2)
print("Descriptive statistics:")
x = stats.describe(d1)
print("Number of observations:", x.nobs)
print("Minimum:", x.minmax[0])
print("Maximum:", x.minmax[1])
print("Mean:", x.mean)
print("Variance:", x.variance)
print("Skewness:", x.skewness)
print("Kurtosis:", x.kurtosis)
print("Normal Distribution:")
mean = np.mean(d1)
std = np.std(d1)
x = 15
print("Mean:", mean)
print("Standard deviation:", std)
print("PDF:", stats.norm.pdf(x, mean, std))
print("CDF:", stats.norm.cdf(x, mean, std))
print("Independent T-test:")
t_stat, p_value = stats.ttest_ind(d1, d2)
print("T-statistics:", t_stat)
print("p-value:", p_value)
if p_value < 0.05:
    print("Significance difference between two datasets")
else:
    print("No significance difference between two datasets")
