import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import binom, poisson

# Binomial distribution
trials = 10
success_prob = 0.5
head_probability = binom.pmf(5, trials, success_prob)
print("Probability for exactly 5 heads:", head_probability)
outcomes = np.arange(0, 11)
prob_values = binom.pmf(outcomes, trials, success_prob)
print("\nBinomial Probability Table")
for idx in range(len(outcomes)):
    print("Outcome (X) =", outcomes[idx], "| Probability =", round(prob_values[idx], 4))

# Poisson distribution.
average_rate = 4
request_probability = poisson.pmf(3, average_rate)
print("Probability for exactly 3 requests:", request_probability)
request_counts = np.arange(0, 12)
request_probs = poisson.pmf(request_counts, average_rate)
print("\nPoisson Probability Table")
for idx in range(len(request_counts)):
    print("Requests =", request_counts[idx], "| Probability =", round(request_probs[idx], 4))

# Binomial plot
plt.subplot(1, 2, 1)
plt.bar(
    np.arange(0, 11),
    binom.pmf(np.arange(0, 11), 10, 0.5),
    color="teal"
)
plt.title("Binomial Distribution")
plt.xlabel("Outcome (X)")
plt.ylabel("Probability")

# Poisson plot
plt.subplot(1, 2, 2)
plt.bar(
    np.arange(0, 12),
    poisson.pmf(np.arange(0, 12), 4),
    color="palevioletred"
)
plt.title("Poisson Distribution")
plt.xlabel("Requests")
plt.ylabel("Probability")

plt.tight_layout()
plt.show()
