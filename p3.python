#If
num=int(input("enter a number:"))
if num>0:
  print("positive number")

#If-else
num=int(input("enter a number:"))
if num%2==0:
  print("even number")
else:
  print("odd number")

#Elif
marks=int(input("enter marks:"))
if marks>=90:
  print("grade A")
elif marks>=75:
  print("grade B")
elif marks>=50:
  print("grade C")
else:
  print("fail")

#While loop
i=1
while i<=5:
  print(i)
  i+=1

#For loop
for i in range(1,6):
  print(i)

#2Nested loop
1for i in range(3):
  for j in range(3):
    print("23",end="")
    print()

#Break
for i in range(1,11):
  if i==5:
    break
    print(i)

#Continue
for i in range(1,7):
  if i==5:
    continue
    print(i)

#pass
for i in range(1,4):
  if i==2:
    pass
    print(i)


